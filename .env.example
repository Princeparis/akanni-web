# Optional: your deployed origin for absolute social and sitemap URLs.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact delivery: Gmail SMTP via Nodemailer (server only).
# Create a Google App Password with 2-Step Verification enabled.
# Set SMTP_PASSWORD in your hosting platform's secure environment settings.
# Never use your normal Google password or prefix this variable with NEXT_PUBLIC_.
# SMTP_USER=wemzain@gmail.com
# SMTP_PASSWORD=
# SMTPS defaults; TLS certificate verification stays enabled.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
